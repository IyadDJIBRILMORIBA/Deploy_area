# AREA Backend - Render Environment Variables Configuration
# Copy these to your Render service environment variables

# ============================================
# APPLICATION
# ============================================
APP_NAME=AREA
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-service-name.onrender.com
APP_KEY=base64:YOUR_GENERATED_KEY_HERE

# ============================================
# DATABASE
# ============================================
# For PostgreSQL (Render native - recommended)
DB_CONNECTION=pgsql
DB_HOST=your-postgres-host.render.com
DB_PORT=5432
DB_DATABASE=area_database
DB_USERNAME=area_user
DB_PASSWORD=your_postgres_password

# For MySQL (external service)
# DB_CONNECTION=mysql
# DB_HOST=your-mysql-host.com
# DB_PORT=3306
# DB_DATABASE=area_database
# DB_USERNAME=area_user
# DB_PASSWORD=your_mysql_password

# ============================================
# LARAVEL CONFIGURATION
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=error
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ============================================
# OAUTH - GOOGLE
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-service-name.onrender.com/api/auth/google/callback

# ============================================
# OAUTH - MICROSOFT
# ============================================
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=https://your-service-name.onrender.com/api/auth/microsoft/callback

# ============================================
# OAUTH - SPOTIFY
# ============================================
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://your-service-name.onrender.com/api/auth/spotify/callback

# ============================================
# OAUTH - GITHUB
# ============================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://your-service-name.onrender.com/api/auth/github/callback

# ============================================
# OAUTH - DISCORD
# ============================================
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://your-service-name.onrender.com/api/auth/discord/callback

# ============================================
# CORS CONFIGURATION
# ============================================
# Update this with your frontend URL
FRONTEND_URL=https://your-frontend.onrender.com

# ============================================
# OPTIONAL SERVICES
# ============================================
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@area.com
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# SECURITY
# ============================================
SANCTUM_STATEFUL_DOMAINS=your-frontend.onrender.com
SESSION_SECURE_COOKIE=true
