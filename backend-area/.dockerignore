# Git
.git/
.gitignore
.gitattributes

# Environment
.env
.env.local
.env.testing
storage/*.key

# IDE & Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Dependencies (will be installed during build)
node_modules/
npm-debug.log
yarn-error.log

# Public storage (created at runtime)
public/storage
/public/hot

# Logs
*.log
/storage/logs/*
!/storage/logs/.gitkeep

# Tests & Development
tests/
.phpunit.cache
.phpunit.result.cache
phpunit.xml

# Cache directories
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep

# Documentation
*.md
!README.md
docs/

# Deployment scripts
setup-render.sh
docker-compose.yml
area-scheduler.service
install-scheduler.sh

# Temporary files
*.tmp
*.bak
.DS_Store
Thumbs.db
